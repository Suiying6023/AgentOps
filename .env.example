MODE=dev

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Leave empty to disable auth in local development.
# Set a value to require Authorization: Bearer <AUTH_SECRET>.
AUTH_SECRET=
SILICONFLOW_PRIMARY_KEY=
SILICONFLOW_FALLBACK_KEY=

# PostgreSQL 数据库配置
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops_dev_password
